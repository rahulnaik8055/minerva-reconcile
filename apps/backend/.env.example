# Reconcile Backend Environment Variables
# Copy to .env and fill in real values. Never commit .env files.
NODE_ENV=development
PORT=3001

# PostgreSQL connection string
# Local (Docker Compose): postgresql://postgres:postgres@localhost:5432/reconcile
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reconcile

# CORS origin for the frontend
FRONTEND_URL=http://localhost:3000

# Secret used to sign JWTs. MUST be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# JWT lifetime (e.g. 15m, 7d)
JWT_EXPIRATION=7d

# Optional: overrides the default log level (debug in dev, info in production)
# LOG_LEVEL=info
