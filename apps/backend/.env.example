# Backend Environment Variables
# Copy to .env and fill in real values. Never commit .env files.

NODE_ENV=development
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reconcile

# CORS origin for the frontend
FRONTEND_URL=http://localhost:3000

# Clerk — get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...

# Optional: AI assistance (advisory only, never mutates data)
# When unset, all AI buttons are hidden and the product works fully without them.
AICREDITS_API_KEY=
# Required when AICREDITS_API_KEY is set: model id for AICredits
AICREDITS_MODEL=
# Optional: override the AICredits base URL (default https://api.aicredits.in/v1)
# AICREDITS_BASE_URL=https://api.aicredits.in/v1
