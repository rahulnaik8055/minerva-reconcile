# Reconcile Frontend Environment Variables
# Copy to .env and fill in real values. Never commit .env files.

# Public API base URL (exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Server-side only. MUST match the backend JWT_SECRET.
# Used by middleware to verify the session cookie.
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
