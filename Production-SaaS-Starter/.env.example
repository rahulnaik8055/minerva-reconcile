# Reconcile - Root Environment Variables
# This file documents every environment variable used by the project.
# Copy individual values into apps/backend/.env and apps/frontend/.env.

# ---------------------------------------------------------------------------
# Backend (apps/backend/.env)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# PostgreSQL connection string (see docs/database.md)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reconcile

# CORS origin for the frontend
FRONTEND_URL=http://localhost:3000

# JWT signing secret. MUST be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRATION=7d

# Optional: overrides default log level (debug in dev, info in production)
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Frontend (apps/frontend/.env)
# ---------------------------------------------------------------------------
# Public API base URL (exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
