{
  "name": "matchbook",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first financial reconciliation workbench: Next.js, NestJS, Drizzle ORM, and PostgreSQL",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build": "concurrently \"npm run build:backend\" \"npm run build:frontend\"",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "lint": "concurrently \"npm run lint:backend\" \"npm run lint:frontend\"",
    "lint:backend": "npm run lint --workspace=apps/backend",
    "lint:frontend": "npm run lint --workspace=apps/frontend",
    "typecheck": "concurrently \"npm run typecheck:backend\" \"npm run typecheck:frontend\"",
    "typecheck:backend": "tsc --noEmit --project apps/backend/tsconfig.json",
    "typecheck:frontend": "npm run type-check --workspace=apps/frontend",
    "test": "npm run test --workspace=apps/backend",
    "test:watch": "npm run test:watch --workspace=apps/backend",
    "test:cov": "npm run test:cov --workspace=apps/backend",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json}\"",
    "clean": "concurrently \"npm run clean:backend\" \"npm run clean:frontend\"",
    "clean:backend": "rimraf apps/backend/dist apps/backend/coverage",
    "clean:frontend": "rimraf apps/frontend/.next apps/frontend/coverage",
    "db:generate": "npm run db:generate --workspace=apps/backend",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:push": "npm run db:push --workspace=apps/backend",
    "db:studio": "npm run db:studio --workspace=apps/backend",
    "db:seed": "npm run db:seed --workspace=apps/backend",
    "db:reset": "npm run db:reset --workspace=apps/backend",
    "db:demo": "npm run db:demo --workspace=apps/backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
