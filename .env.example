# Reconcile - Root Environment Variables
# This file documents every environment variable used by the project.
# Copy individual values into apps/backend/.env and apps/frontend/.env.

# ---------------------------------------------------------------------------
# Backend (apps/backend/.env)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# PostgreSQL connection string (see docs/database.md)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reconcile

# CORS origin for the frontend
FRONTEND_URL=http://localhost:3000

# JWT signing secret. MUST be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRATION=7d

# Optional: overrides default log level (debug in dev, info in production)
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Optional AI assistance (apps/backend/.env) - the product works fully without these
# ---------------------------------------------------------------------------
# When OPENAI_API_KEY is unset, all AI actions are hidden and deterministic
# explanations keep working. The AI layer is advisory only: it can never create,
# modify, approve, or delete any record.
OPENAI_API_KEY=
# Optional: any OpenAI-compatible model id (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible gateway (default https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Frontend (apps/frontend/.env)
# ---------------------------------------------------------------------------
# Public API base URL (exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
