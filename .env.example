# Reconcile — Environment Variables
# Copy the relevant sections into:
#   apps/backend/.env   (backend config)
#   apps/frontend/.env  (frontend config)

# ---------------------------------------------------------------------------
# Backend (apps/backend/.env)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# PostgreSQL connection string (see docs/database.md)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reconcile

# CORS origin for the frontend
FRONTEND_URL=http://localhost:3000

# JWT signing secret — must be at least 32 characters
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRATION=7d

# Optional: AI assistance (advisory only, never mutates data)
# When unset, all AI buttons are hidden and the product works fully without them.
AICREDITS_API_KEY=
# Required when AICREDITS_API_KEY is set: model id for AICredits
AICREDITS_MODEL=
# Optional: override the AICredits base URL (default https://api.aicredits.in/v1)
# AICREDITS_BASE_URL=https://api.aicredits.in/v1

# ---------------------------------------------------------------------------
# Frontend (apps/frontend/.env)
# ---------------------------------------------------------------------------
# Public API base URL (exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Must match the backend JWT_SECRET — used by middleware to verify session cookies
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
